# Supabase Postgres connection string.
# Use the "Transaction pooler" connection string from Supabase (Project Settings > Database)
# for the app, and the direct connection for running migrations if the pooler doesn't support them.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

PORT=3000

# Supabase Postgres connection strings (Project Settings > Database > Connection string).
#
# DATABASE_URL: "Transaction pooler" (port 6543). Used by the running app (PrismaService) -
# handles many short-lived connections, which is what a long-running API server needs.
#
# DIRECT_URL: "Session pooler" (port 5432). Used by prisma.config.ts for CLI commands
# (migrate, db push, studio) - the transaction pooler doesn't support the prepared
# statements/advisory locks these need. Don't use the "Direct connection" host
# (db.<project-ref>.supabase.co) here - it's IPv6-only and unreachable on most networks;
# the session pooler is the IPv4-reachable alternative for CLI/migration use.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

PORT=3000

# Comma-separated list of origins allowed to call the API via CORS.
# Defaults to the local job-seek-web/job-seek-dashboard dev servers when unset.
# Set explicitly in production to the deployed frontend origin(s).
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4200"

{
  "name": "job-seek",
  "version": "1.0.0",
  "private": true,
  "description": "job-seek monorepo: CLI + web (React shell, Angular dashboard, NestJS API)",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "cli": "pnpm --filter job-seek-cli",
    "web": "pnpm --filter job-seek-web",
    "dashboard": "pnpm --filter job-seek-dashboard",
    "api": "pnpm --filter job-seek-api"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.5.0"
  }
}
